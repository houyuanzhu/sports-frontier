{
  "name": "sports-frontier",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check:update": "node scripts/collect.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run test && npm run build && node scripts/verify-build.mjs",
    "collect": "node scripts/collect.mjs",
    "collect:publish": "node scripts/collect.mjs --publish",
    "content:restore": "node scripts/content-state.mjs restore"
  },
  "dependencies": {
    "astro": "5.18.2",
    "@astrojs/sitemap": "3.7.4",
    "tailwindcss": "4.3.4",
    "@tailwindcss/vite": "4.3.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "cheerio": "1.2.0",
    "yaml": "2.9.1"
  }
}

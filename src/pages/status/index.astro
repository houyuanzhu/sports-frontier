---
import Layout from '../../layouts/Layout.astro';
import {dateText,url,posts} from '../../lib/content.mjs';
import {checkLabels} from '../../lib/daily.mjs';
import status from '../../data/status.json';
import {publicationStats} from '../../lib/publication.mjs';
const issueNames={access:'访问限制',network:'网络故障',timeout:'超时',http:'上游 HTTP 错误',structure:'结构或必填字段异常',date:'日期解析异常',excluded:'编辑筛选',unexpected:'未分类故障'};
const stageNames={robots:'访问规则文件',list:'列表页',detail:'详情页',api:'接口请求',record:'书目字段'};
const rate=value=>value?.denominator?`${value.numerator}/${value.denominator}（${(100*value.numerator/value.denominator).toFixed(1)}%）`:'暂无可用分母';
const stats=publicationStats(posts);
const labels={failed:'检查失败',partial:'部分来源不可用',updated:'本次已有新增索引',rolled_back:'已恢复历史快照',not_configured:'尚未接入内容源',pending_review:'发现候选，等待审阅',no_change:'检查完成，无新增内容'};
---
<Layout title="运行状态"><div class="page-heading"><p class="eyebrow">透明运行记录</p><h1>检查有记录，更新有依据<span>。</span></h1><p>本页是最近一次成功部署时的状态快照。若部署失败，本页不会自动变化，请以仓库运行日志为准。</p></div><section class="status-detail"><h2>{checkLabels[status.state]||labels[status.state]||'系统检查已有记录'}</h2><p>{status.message}</p><dl><dt>最近检查范围</dt><dd>{status.collectionMode==='recovery'?'故障来源补检':'正常检查'} · {status.scannedSourceIds?.length??status.sources?.length??0} 个入口</dd><dt>最近采集检查时间（北京时间）</dt><dd>{dateText(status.checkedAt,true)}</dd>{status.rolledBackAt&&<><dt>回滚时间（北京时间）</dt><dd>{dateText(status.rolledBackAt,true)}</dd></>}<dt>近 7 日原文发布数</dt><dd>{stats.last7} 条</dd><dt>近 30 日原文发布数</dt><dd>{stats.last30} 条</dd><dt>最新有效资讯原文日期</dt><dd>{dateText(stats.latestEffective,true)}</dd><dt>来源内容最近发布日期</dt><dd>{dateText(status.lastContentPublishedAt,true)}</dd><dt>本次实际新增索引数</dt><dd>{status.newCount} 条</dd><dt>已存储历史条数</dt><dd>{status.storedCount??'尚无记录'}</dd><dt>抽查分类准确率</dt><dd>{rate(status.quality?.classification)}</dd><dt>本轮重复候选比例</dt><dd>{rate(status.quality?.duplicateCandidates)}</dd><dt>本轮候选信息排除率</dt><dd>{rate(status.quality?.candidateExclusion)}</dd><dt>已发布记录错误率（已核验样本）</dt><dd>{rate(status.quality?.publishedRecordErrors)}</dd><dt>待人工抽查</dt><dd>{status.auditQueue?.length??0} 条</dd><dt>最近采集请求数</dt><dd>{status.attempts}</dd><dt>网络重试次数</dt><dd>{status.retries??0}</dd><dt>跨来源或历史重复条数</dt><dd>{status.duplicateCount??0}</dd><dt>计划检查时间</dt><dd>北京时间 08:10，11:37 备用检查</dd><dt>运行记录</dt><dd>{status.runId?<a href={`https://github.com/houyuanzhu/sports-frontier/actions/runs/${status.runId}`}>查看计划、执行、发布和失败记录 ↗</a>:<a href="https://github.com/houyuanzhu/sports-frontier/actions/workflows/pages.yml">查看云端运行 ↗</a>}</dd></dl><p>近 7 日、30 日均含今天，按北京时间日历与原文发布日期计算。最新有效资讯限定在近 30 日，科研机会须有已核验且仍开放的申请期，仍以原文确认有效性。</p><p>重复候选比例以已通过采集门槛的候选为分母。排除率以可判定详情为分母，含过期及不适用条目。已发布记录错误率只计完成核验的已发布样本。跳过执行只在云端日志记录，保留已有公开快照。</p><p>发布经核验的官方信息和论文书目索引。来源发布日期、系统采集时间和部署状态分别记录；系统检查成功不等于资讯更新。</p>{status.sources&&<div class="source-status"><h3>各来源最近一次检查</h3>{status.sources.map(source=><section><h4>{source.name}</h4><p>{dateText(source.lastAttemptAt||source.checkedAt,true)}（北京时间）</p><p>{source.status==='success'?'访问与解析完成':source.status==='partial'?'部分条目不可用':'访问失败，已跳过'} · 核验通过 {source.acceptedCount||0} 条 · 列表 {source.pages?.length||0} 页 · 跳过 {source.skipped?.length||0} 条</p>{[source.issue,...(source.skipped||[]).map(entry=>entry.issue)].filter(issue=>issue&&issue.kind!=='excluded').slice(0,3).map(issue=><p>{issueNames[issue.kind]} · {stageNames[issue.stage]||'采集阶段'}{issue.http?' · HTTP '+issue.http:''}{issue.code?' · '+issue.code:''}</p>)}
 {status.sourceHistory?.[source.sourceId]&&<><p>最近最多 30 次完整成功 {status.sourceHistory[source.sourceId].successes}/{status.sourceHistory[source.sourceId].attempts} · 有效存档 {status.sourceHistory[source.sourceId].publishedCount} 条</p><p>最近完整成功 {dateText(status.sourceHistory[source.sourceId].lastSuccessAt,true)} · {status.sourceHistory[source.sourceId].failureSince?'故障自 '+dateText(status.sourceHistory[source.sourceId].failureSince,true)+' 起（至本轮 '+Math.floor(status.sourceHistory[source.sourceId].failureMs/60000)+' 分钟）':'当前无已观测故障'}</p></>}</section>)}</div>}<a class="text-link" href={url('sources/')}>查看来源与使用规则 ↗</a></section></Layout>

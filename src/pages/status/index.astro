---
import Layout from '../../layouts/Layout.astro';
import {dateText,url,posts} from '../../lib/content.mjs';
import status from '../../data/status.json';
import {publicationStats} from '../../lib/publication.mjs';
const stats=publicationStats(posts);
const labels={failed:'检查失败',partial:'部分来源不可用',updated:'本次已有新增索引',rolled_back:'已恢复历史快照',not_configured:'尚未接入内容源',pending_review:'发现候选，等待审阅',no_change:'检查完成，无新增内容'};
---
<Layout title="运行状态"><div class="page-heading"><p class="eyebrow">透明运行记录</p><h1>检查有记录，更新有依据<span>。</span></h1><p>本页是最近一次成功部署时的状态快照。若部署失败，本页不会自动变化，请以仓库运行日志为准。</p></div><section class="status-detail"><h2>{labels[status.state]||'系统检查已有记录'}</h2><p>{status.message}</p><dl><dt>最近采集检查时间（北京时间）</dt><dd>{dateText(status.checkedAt,true)}</dd>{status.rolledBackAt&&<><dt>回滚时间（北京时间）</dt><dd>{dateText(status.rolledBackAt,true)}</dd></>}<dt>近 7 日原文发布数</dt><dd>{stats.last7} 条</dd><dt>近 30 日原文发布数</dt><dd>{stats.last30} 条</dd><dt>最新有效资讯原文日期</dt><dd>{dateText(stats.latestEffective,true)}</dd><dt>来源内容最近发布日期</dt><dd>{dateText(status.lastContentPublishedAt,true)}</dd><dt>本次实际新增索引数</dt><dd>{status.newCount} 条</dd><dt>已存储历史条数</dt><dd>{status.storedCount??'尚无记录'}</dd><dt>最近采集请求数</dt><dd>{status.attempts}</dd><dt>网络重试次数</dt><dd>{status.retries??0}</dd><dt>跨来源或历史重复条数</dt><dd>{status.duplicateCount??0}</dd><dt>计划检查时间</dt><dd>北京时间 08:10，11:37 备用检查</dd><dt>运行记录</dt><dd>{status.runId?<a href={`https://github.com/houyuanzhu/sports-frontier/actions/runs/${status.runId}`}>查看计划、执行、发布和失败记录 ↗</a>:<a href="https://github.com/houyuanzhu/sports-frontier/actions/workflows/pages.yml">查看云端运行 ↗</a>}</dd></dl><p>近 7 日、30 日均含今天，按北京时间日历与原文发布日期计算。最新有效资讯限定在近 30 日，科研机会须有已核验且未过的截止日期，仍以原文确认有效性。</p><p>发布经核验的官方信息和论文书目索引。来源发布日期、系统采集时间和部署状态分别记录；系统检查成功不等于资讯更新。</p>{status.sources&&<div class="source-status"><h3>最近来源检查</h3>{status.sources.map(source=><section><h4>{source.name}</h4><p>{source.status==='success'?'访问与解析完成':source.status==='partial'?'部分条目不可用':'访问失败，已跳过'} · 核验通过 {source.acceptedCount||0} 条 · 列表 {source.pages?.length||0} 页 · 跳过 {source.skipped?.length||0} 条</p>{source.error&&<p>{source.error}</p>}</section>)}</div>}<a class="text-link" href={url('sources/')}>查看来源与使用规则 ↗</a></section></Layout>

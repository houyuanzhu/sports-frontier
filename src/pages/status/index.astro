---
import Layout from '../../layouts/Layout.astro';
import {dateText,url} from '../../lib/content.mjs';
import status from '../../data/status.json';
const labels={failed:'检查失败',partial:'部分来源不可用',updated:'本次已有新增索引',rolled_back:'已恢复历史快照',not_configured:'尚未接入内容源',pending_review:'发现候选，等待审阅',no_change:'检查完成，无新增内容'};
---
<Layout title="运行状态"><div class="page-heading"><p class="eyebrow">透明运行记录</p><h1>检查有记录，更新有依据<span>。</span></h1><p>本页是最近一次成功部署时的状态快照。若部署失败，本页不会自动变化，请以仓库运行日志为准。</p></div><section class="status-detail"><h2>{labels[status.state]||'系统检查已有记录'}</h2><p>{status.message}</p><dl><dt>系统检查时间（北京时间）</dt><dd>{dateText(status.checkedAt,true)}</dd><dt>来源内容最近发布日期</dt><dd>{dateText(status.lastContentPublishedAt,true)}</dd><dt>本次实际新增索引数</dt><dd>{status.newCount} 条</dd><dt>已存储历史条数</dt><dd>{status.storedCount??'尚无记录'}</dd><dt>本次网络请求数</dt><dd>{status.attempts}</dd><dt>网络重试次数</dt><dd>{status.retries??0}</dd><dt>跨来源或历史重复条数</dt><dd>{status.duplicateCount??0}</dd><dt>计划检查时间</dt><dd>每天北京时间08:10（可能延迟）</dd></dl><p>只发布通过字段核验的官方信息索引。来源发布日期、系统采集时间和部署状态分别记录；系统检查成功不等于资讯更新。</p>{status.sources&&<div class="source-status"><h3>本次来源检查</h3>{status.sources.map(source=><section><h4>{source.name}</h4><p>{source.status==='success'?'访问与解析完成':source.status==='partial'?'部分条目不可用':'访问失败，已跳过'} · 核验通过 {source.acceptedCount||0} 条 · 跳过 {source.skipped?.length||0} 条</p>{source.error&&<p>{source.error}</p>}</section>)}</div>}<a class="text-link" href={url('sources/')}>查看来源与使用规则 ↗</a></section></Layout>

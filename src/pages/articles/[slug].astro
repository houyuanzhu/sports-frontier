---
import Layout from '../../layouts/Layout.astro';
import Art from '../../components/Art.astro';
import {allPosts,posts,url,dateText,categoryName,contentTag} from '../../lib/content.mjs';
import {lifecycle} from '../../lib/publication.mjs';
import {opportunityKind,opportunityLabels} from '../../../scripts/ingest-core.mjs';
export function getStaticPaths(){return allPosts.map(post=>({params:{slug:post.slug},props:{post}}))}
const {post}=Astro.props;
const withdrawn=post.editorial?.action==='withdraw';
const related=posts.filter(p=>p.slug!==post.slug).sort((a,b)=>Number(b.category===post.category)-Number(a.category===post.category)).slice(0,2);
---
<Layout title={withdrawn?'已撤回资讯':post.title} description={withdrawn?'这条资讯已撤回。':post.summary} article={withdrawn?undefined:post}>{withdrawn?<div class="page-heading"><h1>资讯已撤回</h1><p>{post.editorial.note}</p><p>{dateText(post.editorial.date)}</p></div>:<><div class="breadcrumbs"><a href={url('articles/')}>全部内容</a><span>/</span><a href={url(`categories/${post.category}/`)}>{categoryName(post.category)}</a></div><article class="article"><header><p class="eyebrow">{categoryName(post.category)} / {contentTag(post)}</p><h1>{post.title}</h1>{lifecycle(post)&&<p class="eyebrow">{lifecycle(post)}</p>}{post.editorial?.action==='notice'&&<p class="notice">更正说明 · {dateText(post.editorial.date)} · {post.editorial.note}</p>}<p class="standfirst">{post.summary}</p><div class="meta"><span>{post.demo?'政视体育 · 演示编辑':post.source}</span><time datetime={post.publishedAt}>{dateText(post.publishedAt,post.datePrecision!=='day')} 原文发布</time><span>{post.minutes} 分钟阅读</span></div></header><Art kind={post.art} large/><div class="article-body"><div class="notice">{post.demo?'演示内容 · 本文用于展示阅读体验，不是真实资讯报道。':post.contentType==='research-index'?'论文书目索引 · 保留英文原题，证据强度待独立评估。':'官方信息索引 · 标题与日期来自原始公开页面。'}</div>{!post.demo&&<section class="source-facts"><h2>来源与核验</h2><dl><dt>原公开主体</dt><dd>{post.source}</dd><dt>原文发布日期</dt><dd>{dateText(post.publishedAt)}{post.datePrecision==='day'?'（来源未提供具体时分）':''}</dd><dt>首次收录时间</dt><dd>{dateText(post.firstIndexedAt,true)}</dd><dt>栏目依据</dt><dd>{post.classificationRule}</dd></dl><a class="text-link" href={post.url} target="_blank" rel="noopener noreferrer">{post.doi?'通过 DOI 查阅出版物 ↗':'阅读官方原文 ↗'}</a>{post.opportunity&&<><h2>科研机会 · {opportunityLabels[post.opportunity.kind||opportunityKind(post.title)]}</h2><dl><dt>申报截止日期</dt><dd>{post.opportunity.deadline?dateText(post.opportunity.deadline):'未核实，以官方原文为准'}</dd><dt>申报条件</dt><dd>{post.opportunity.eligibility||'未核实，以官方原文为准'}</dd></dl><p class="fact-note">日期精度为日；不推断具体截止时刻。请到官方入口确认当前是否仍可申请。</p></>}</section>}{post.body.map(part=><section><h2>{part.heading}</h2><p>{part.text}</p></section>)}<p class="article-end">— 本文完 —</p></div></article><section class="related"><div class="section-line"><h2>继续阅读</h2><a href={url('articles/')}>返回内容列表 ↗</a></div>{related.map(p=><a href={url(`articles/${p.slug}/`)}>{p.title} ↗</a>)}</section></>}</Layout>

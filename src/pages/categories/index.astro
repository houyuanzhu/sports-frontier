---
import Layout from '../../layouts/Layout.astro';
import {site,posts,url} from '../../lib/content.mjs';
---
<Layout title="阅读栏目"><div class="page-heading"><p class="eyebrow">栏目索引</p><h1>六个维度，看见体育<span>。</span></h1><p>从政策到科研，从技术到产业。以体育为中心，连接专业信息。</p></div><div class="category-grid">{site.categories.map((c,i)=><a href={url(`categories/${c.slug}/`)}><span class="eyebrow">栏目 0{i+1}</span><h2>{c.name} ↗</h2><p>{c.description}</p><small>{posts.filter(p=>p.category===c.slug).length} 条内容</small></a>)}</div></Layout>

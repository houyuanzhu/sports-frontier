---
import Layout from '../layouts/Layout.astro';
import Art from '../components/Art.astro';
import PostRow from '../components/PostRow.astro';
import {posts,site,url,dateText,categoryName} from '../lib/content.mjs';
import {calendarDay,opportunityState} from '../lib/publication.mjs';
import {recentImportant} from '../lib/information.mjs';
import {buildEditions,editionFact,checkLabels} from '../lib/daily.mjs';
import status from '../data/status.json';
const today=calendarDay(new Date());
const important=posts.filter(post=>post.signoff&&recentImportant(post,today));
const lead=important[0];
const editions=buildEditions(posts,status);
const current=editions[0];
const age=post=>(Date.parse(today)-Date.parse(calendarDay(post.publishedAt)))/86400000;
const latest=posts.filter(post=>post.slug!==lead?.slug&&post.informationType!=='paper'&&age(post)>=0&&age(post)<30&&
 (post.informationType!=='opportunity'||opportunityState(post,today)==='open')).slice(0,6);
const application=posts.filter(post=>post.category==='opportunities');
const totals=Object.fromEntries(['open','closed','unverified'].map(state=>[state,application.filter(post=>opportunityState(post,today)===state).length]));
const featuredPaper=posts.find(post=>post.paperNote);
const tech=posts.find(post=>post.category==='technology'&&post.factNote&&!latest.includes(post));
---
<Layout>
 <section class="intro sports-intro"><div><p class="eyebrow"><span class="kicker-rule"></span>体育专业情报平台 · 来源可核验</p><h1>以体育为中心，<br/>读懂<span>下一程。</span></h1></div><div class="intro-note"><p>{site.tagline}</p><span>从政策到科技，从研究到产业。<br/>在变化之中，寻找清晰的专业坐标。</span></div></section>
 <section class="daily-hero">
  <div><p class="eyebrow">每日体育情报 · 北京时间</p><h2>{current?`${dateText(current.date)}情报`:'每日情报归档'}</h2><p>{current?`当日首次收录 ${current.count} 条。${current.check?(current.check.newCount?`最近一轮新增 ${current.check.newCount} 条。`:'最近一轮暂无新增。'):''}`:'暂无可归档的真实记录。'}{current?.check&&<> {checkLabels[current.check.state]}。</>}</p></div>
  <a class="text-link" href={url(current?`daily/${current.date}/`:'daily/')}>阅读最近一期 ↗</a>
 </section>
 <div class="section-line"><h2>重要体育资讯 <span>近 30 日 · 编辑签发</span></h2><a href={url('search/?type=important')}>重要资讯归档 ↗</a></div>
 {lead?<section class="lead sports-lead"><a class="lead-art" href={url(`articles/${lead.slug}/`)} aria-label={lead.title}><Art kind={lead.art} large/></a><div class="lead-copy"><div class="eyebrow">{categoryName(lead.category)} · {lead.signoff.editor}签发</div><h2><a href={url(`articles/${lead.slug}/`)}>{lead.title}</a></h2><p>{editionFact(lead)}</p><div class="meta"><time datetime={lead.publishedAt}>{dateText(lead.publishedAt)}</time></div></div></section>:<p class="empty-state">近 30 日暂无已签发的重要资讯。</p>}
 {important.length>1&&<section class="brief-grid" aria-label="更多已签发资讯">{important.slice(1,3).map(post=><article><p class="eyebrow">{categoryName(post.category)}</p><h2><a href={url(`articles/${post.slug}/`)}>{post.title}</a></h2><p>{editionFact(post)}</p></article>)}</section>}
 <div class="content-grid"><section><div class="section-line"><h2>最新有效体育信息 <span>近 30 日 · 原文日期</span></h2><a href={url('articles/')}>全部内容 ↗</a></div>
 {latest.map((post,index)=><PostRow post={post} index={index}/>)}
 {!latest.length&&<p class="empty-state">暂无符合当前展示条件的近期信息。</p>}
 </section><aside>
  <section class="aside-block"><p class="eyebrow">体育科技与科研精选</p><h2>技术应用与研究证据</h2>
   {tech&&<p><a href={url(`articles/${tech.slug}/`)}>{tech.title}</a><br/>{dateText(tech.publishedAt)} · 事实资料</p>}
   {featuredPaper?<p><a href={url(`articles/${featuredPaper.slug}/`)}>{featuredPaper.paperNote.chineseTitle}</a></p>:<p>暂无已签发的论文解读。</p>}
   <a class="text-link" href={url('research/')}>体育科研精选 ↗</a>
  </section>
  <section class="aside-block"><p class="eyebrow">科研机会</p><h2>申请状态</h2><p>当前站点快照 · 开放申请 {totals.open} · 已截止 {totals.closed} · 待核实 {totals.unverified}</p><a class="text-link" href={url('categories/opportunities/')}>按状态查看机会 ↗</a></section>
  <section class="aside-block"><p class="eyebrow">体育风口观察</p><h2>追踪证据与变化</h2><p>AI+体育、智能可穿戴、运动健康、全民健身、体育产业、赛事经济和运动训练科技。</p><a class="text-link" href={url('trends/')}>查看七个观察方向 ↗</a></section>
  <section class="aside-block"><p class="eyebrow">六大专业栏目</p><h2>从兴趣，走向深入</h2>{site.categories.map((c,i)=><a class="category-link" href={url(`categories/${c.slug}/`)}><span><small>{String(i+1).padStart(2,'0')}</small>{c.name}<em>{c.short}</em></span><span>↗</span></a>)}</section>
  <section class="status-card"><div class="status-dot">{checkLabels[status.state]||'尚无采集记录'}</div><p>{status.message}</p><dl><dt>最近采集检查时间</dt><dd>{dateText(status.checkedAt,true)}</dd></dl><a class="text-link" href={url('status/')}>查看运行状态 ↗</a></section>
 </aside></div>
 <section class="closing"><p class="eyebrow">把专业信息，放回体育的现场</p><h2>{site.tagline}</h2><a href={url('about/')}>了解政视体育 ↗</a></section>
</Layout>

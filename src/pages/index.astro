---
import Layout from '../layouts/Layout.astro';
import Art from '../components/Art.astro';
import PostRow from '../components/PostRow.astro';
import {posts,site,url,dateText,categoryName,contentTag} from '../lib/content.mjs';
import {calendarDay} from '../lib/publication.mjs';
import {recentImportant} from '../lib/information.mjs';
import status from '../data/status.json';
const important=posts.filter(p=>recentImportant(p,calendarDay(new Date())));
const lead=important[0];
const supporting=important.slice(1,3);
const latest=posts.filter(p=>p.informationType==='index').slice(0,8);
---
<Layout>
 <section class="intro sports-intro"><div><p class="eyebrow"><span class="kicker-rule"></span>{site.demo?'体育专业情报平台 · 演示阶段':'体育专业情报平台 · 来源可核验'}</p><h1>以体育为中心，<br/>读懂<span>下一程。</span></h1></div><div class="intro-note"><p>{site.tagline}</p><span>从政策到科技，从研究到产业。<br/>在变化之中，寻找清晰的专业坐标。</span></div></section>
 <div class="section-line"><h2>重要体育资讯 <span>近 30 日 · 编辑核验</span></h2><a href={url('articles/')}>浏览全部内容 ↗</a></div>
 {lead?<section class="lead sports-lead"><a class="lead-art" href={url(`articles/${lead?.slug}/`)} aria-label={`阅读：${lead.title}`}><Art kind={lead.art} large/><span class="visual-label">从赛场，延伸视野</span></a><div class="lead-copy"><div class="eyebrow">{categoryName(lead.category)} <span>/ 最近刊载 · {contentTag(lead)}</span></div><h2><a href={url(`articles/${lead?.slug}/`)}>{lead.title}</a></h2><p>{lead.summary}</p><div class="meta"><time datetime={lead.publishedAt}>{dateText(lead.publishedAt)}</time><span>{lead.minutes} 分钟阅读</span></div><a class="text-link" href={url(`articles/${lead?.slug}/`)}>阅读专题 <span>↗</span></a></div></section>:<p class="empty-state">近 30 日暂无通过重要性复核的资讯。<a class="text-link" href={url('search/?type=important')}>查看已归档的重要资讯 ↗</a></p>}
 {supporting.length>0&&<section class="brief-grid" aria-label="延伸阅读">{supporting.map(p=><article><div class="eyebrow">{categoryName(p.category)} <span>{contentTag(p)}</span></div><h2><a href={url(`articles/${p.slug}/`)}>{p.title}</a></h2><p>{p.summary}</p><div class="meta"><time datetime={p.publishedAt}>{dateText(p.publishedAt)}</time><span>{p.minutes} 分钟阅读</span></div></article>)}</section>}
 <div class="content-grid"><section><div class="section-line"><h2>一般体育信息索引 <span>按原文发布日期</span></h2><a href={url('articles/')}>全部内容 ↗</a></div>{latest.map((post,index)=><PostRow post={post} index={index}/>)}</section><aside><section class="aside-block"><p class="eyebrow">按信息类型阅读</p><a class="category-link" href={url('search/?type=paper')}>科研论文书目 ↗</a><a class="category-link" href={url('categories/opportunities/')}>科研基金及申报机会 ↗</a></section><section class="aside-block"><p class="eyebrow">六大专业栏目</p><h2>从兴趣，走向深入</h2>{site.categories.map((c,i)=><a class="category-link" href={url(`categories/${c.slug}/`)}><span><small>{String(i+1).padStart(2,'0')}</small>{c.name}<em>{c.short}</em></span><span>↗</span></a>)}</section><section class="status-card"><div class="status-dot">{status.state==='failed'?'系统检查失败':status.state==='partial'?'部分来源暂不可用':status.state==='not_configured'?'内容源尚未接入':'系统检查已有记录'}</div><h3>检查有记录，<br/>更新有依据。</h3><p>{status.message}</p><dl><dt>系统检查时间</dt><dd>{dateText(status.checkedAt,true)}</dd><dt>真实资讯最近发布时间</dt><dd>{dateText(status.lastContentPublishedAt,true)}</dd></dl><a class="text-link" href={url('status/')}>查看运行状态 ↗</a></section><div class="aside-note">{site.demo?'当前所有文章均为演示内容。':'发布通过字段核验的官方信息与论文书目。'}<br/>系统检查成功不代表资讯已更新。<br/>不自动生成新闻、政策解读或预测。</div></aside></div>
 <section class="closing"><p class="eyebrow">把专业信息，放回体育的现场</p><h2>{site.tagline}</h2><a href={url('about/')}>了解政视体育 ↗</a></section>
</Layout>

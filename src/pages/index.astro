---
import Layout from '../layouts/Layout.astro';
import Art from '../components/Art.astro';
import PostRow from '../components/PostRow.astro';
import {posts,site,url,dateText} from '../lib/content.mjs';
import status from '../data/status.json';
const lead=posts[0];
---
<Layout><section class="intro"><div><p class="eyebrow">一份开放的中文资讯样刊</p><h1>看见信息，<br class="mobile-break"/>也看见<span>脉络。</span></h1></div><p>为值得关注的事，留一点时间。<br/>在这里，从容阅读，有序探索。</p></section><div class="section-line"><h2>本期精选 <span>· 演示专题</span></h2><span>从一个视角开始阅读</span></div><section class="lead"><a class="lead-art" href={url(`articles/${lead.slug}/`)} aria-label={`阅读：${lead.title}`}><Art kind="orbit" large/></a><div class="lead-copy"><div class="eyebrow">观察 <span>/ 编辑精选 · 演示</span></div><h2><a href={url(`articles/${lead.slug}/`)}>{lead.title}</a></h2><p>{lead.summary}</p><div class="meta"><time datetime={lead.publishedAt}>{dateText(lead.publishedAt)}</time><span>{lead.minutes} 分钟阅读</span></div><a class="text-link" href={url(`articles/${lead.slug}/`)}>阅读全文 <span>↗</span></a></div></section><div class="content-grid"><section><div class="section-line"><h2>最近刊载</h2><a href={url('articles/')}>全部内容 ↗</a></div>{posts.slice(1,5).map((post,index)=><PostRow post={post} index={index}/>)}</section><aside><section class="aside-block"><p class="eyebrow">按兴趣探索</p><h2>阅读栏目</h2>{site.categories.map((c,i)=><a class="category-link" href={url(`categories/${c.slug}/`)}><span><small>〇{['一','二','三'][i]}</small>{c.name}</span><span>↗</span></a>)}</section><section class="status-card"><div class="status-dot">内容源待配置</div><h3>每一次检查，<br/>都如实记录。</h3><p>{status.message}</p><dl><dt>系统检查时间</dt><dd>{dateText(status.checkedAt,true)}</dd><dt>真实资讯发布时间</dt><dd>{dateText(status.lastContentPublishedAt,true)}</dd></dl><a class="text-link" href={url('status/')}>查看运行状态 ↗</a></section><div class="aside-note">本站正处于演示阶段。<br/>名称、内容与栏目均可调整。<br/>此刻，先体验阅读本身。</div></aside></div><section class="closing"><p class="eyebrow">少一点喧嚣，多一点理解</p><h2>{site.tagline}</h2><a href={url('about/')}>了解这份样刊 ↗</a></section></Layout>

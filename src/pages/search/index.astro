---
import Layout from '../../layouts/Layout.astro';
import {posts,site,url,categoryName,dateText,contentTag} from '../../lib/content.mjs';
---
<Layout title="搜索体育情报"><div class="page-heading"><p class="eyebrow">体育情报 / 站内检索</p><h1>让专业线索，触手可及<span>。</span></h1><p>搜索标题、摘要、正文与栏目。仅检索本站已存储内容，不向外部搜索引擎发送查询。</p></div><form id="search-form" role="search"><label for="query">搜索关键词</label><div class="search-box"><input id="query" name="q" type="search" maxlength="100" placeholder="搜索体育政策、可穿戴技术、运动科学……" autocomplete="off"/><button type="submit">搜索 ↗</button></div><div class="search-filters"><label for="category">筛选栏目</label><select id="category" name="category"><option value="">全部栏目</option>{site.categories.map(c=><option value={c.slug}>{c.name}</option>)}</select><button class="reset-search" type="reset">清空条件</button></div></form><div class="search-suggestions" aria-label="搜索建议"><span>试试这些方向</span>{['体育政策','可穿戴','科研机会'].map(term=><button type="button" data-term={term}>{term} ↗</button>)}</div><p id="search-status" role="status" aria-live="polite">全部已存储内容，可输入关键词或选择栏目缩小范围。</p><div id="results" class="listing">{posts.map(p=><article class="search-result" data-category={p.category} data-search={`${p.title} ${p.summary} ${categoryName(p.category)} ${p.body.map(b=>b.text).join(' ')}`.normalize('NFKC').toLocaleLowerCase('zh-CN')}><p class="eyebrow">{categoryName(p.category)} · {contentTag(p)}</p><h2><a href={url(`articles/${p.slug}/`)}>{p.title}</a></h2><p>{p.summary}</p><div class="meta"><time datetime={p.publishedAt}>{dateText(p.publishedAt)}</time><span>{p.minutes} 分钟阅读</span></div></article>)}</div><noscript><p>搜索需要启用浏览器脚本。您仍可浏览上方全部文章或使用浏览器的页面查找功能。</p></noscript>
<script>
const form=document.querySelector<HTMLFormElement>('#search-form')!;
const input=document.querySelector<HTMLInputElement>('#query')!;
const category=document.querySelector<HTMLSelectElement>('#category')!;
const items=[...document.querySelectorAll<HTMLElement>('[data-search]')];
function search(){const q=input.value.trim().normalize('NFKC').toLocaleLowerCase('zh-CN');let n=0;for(const item of items){item.hidden=!!((category.value&&item.dataset.category!==category.value)||!q.split(/\s+/).every(term=>item.dataset.search!.includes(term)));if(!item.hidden)n++}document.querySelector('#search-status')!.textContent=n?`找到 ${n} 条内容。`:'没有找到匹配内容，请尝试其他关键词或清空筛选条件。';const u=new URL(location.href);q?u.searchParams.set('q',input.value.trim()):u.searchParams.delete('q');category.value?u.searchParams.set('category',category.value):u.searchParams.delete('category');history.replaceState(null,'',u)}
function restore(){const params=new URLSearchParams(location.search);input.value=params.get('q')?.slice(0,100)||'';category.value=params.get('category')||'';if(category.selectedIndex<0)category.value='';search()}
restore();form.addEventListener('submit',e=>{e.preventDefault();search()});input.addEventListener('input',search);category.addEventListener('change',search);form.addEventListener('reset',e=>{e.preventDefault();input.value='';category.value='';search()});document.querySelectorAll<HTMLButtonElement>('[data-term]').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.term!;category.value='';search();input.focus()}));window.addEventListener('popstate',restore);
</script></Layout>

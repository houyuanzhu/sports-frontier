---
import Layout from '../../layouts/Layout.astro';
import registry from '../../../sources/registry.json';
import policy from '../../../sources/policy.json';
import {url} from '../../lib/content.mjs';
---
<Layout title="来源与使用规则"><div class="page-heading"><p class="eyebrow">公开来源 / 可追溯索引</p><h1>每一条线索，<br/>都有原始出处<span>。</span></h1><p>当前审核启用 {registry.filter(source=>source.enabled).length} 个入口。最近实测结果以运行状态为准。</p></div><div class="prose"><h2>采集与发布边界</h2><p>{policy.rightsReview}</p><p>访问前检查 robots.txt 和域名范围。遇到 403 停止该来源本轮余下请求。日期按原始精度展示。论文分类基于审核的期刊范围、ISSN、文献类型和 DOI，研究重要性与证据强度需另行评估。</p><h2>来源目录</h2>{registry.map(source=><section class="source-entry"><h3><a href={source.url} target="_blank" rel="noopener noreferrer">{source.name} ↗</a></h3><p>{source.method==='crossref'?'公开书目 API':'公开 HTML 元数据'} · {source.enabled?'已配置采集':'已停用'}。{source.disabledReason||source.classificationBasis}</p>{source.rightsEvidence&&<p><a href={source.rightsEvidence} target="_blank" rel="noopener noreferrer">查看使用条件 ↗</a></p>}</section>)}<p><a href={policy.rightsEvidence}>体育总局公开使用说明 ↗</a></p><p><a href={url('status/')}>查看最近采集与来源状态 ↗</a></p><p><a href={url('about/')}>联系与更正渠道 ↗</a></p></div></Layout>

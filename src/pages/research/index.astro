---
import Layout from '../../layouts/Layout.astro';
import {posts,url,dateText} from '../../lib/content.mjs';
const reviewed=posts.filter(post=>post.paperNote);
const count=posts.filter(post=>post.informationType==='paper').length;
---
<Layout title="体育科研精选">
 <div class="page-heading"><p class="eyebrow">运动科学与技术 / 编辑精选</p><h1>体育科研精选<span>。</span></h1><p>编辑查阅全文后，可录入中文题名、研究设计、主要发现、局限性与专业意义。</p></div>
 <section class="listing"><div class="section-line"><h2>已签发论文解读</h2></div>
 {reviewed.map(post=><article class="edition-item"><p class="eyebrow">编辑签发 · {post.paperNote.editor} · {dateText(post.paperNote.signedOn)}</p><h3><a href={url(`articles/${post.slug}/`)}>{post.paperNote.chineseTitle}</a></h3><p>{post.title}</p><p class="meta">{post.source} · {dateText(post.publishedAt)} · {post.doi}</p></article>)}
 {!reviewed.length&&<p class="empty-state">暂无经全文核验并签发的论文解读。</p>}
 </section>
 <section class="aside-block"><h2>科研论文书目</h2><p>已收录 {count} 条期刊书目，保留英文原标题、期刊、出版日期及 DOI。</p><a class="text-link" href={url('search/?type=paper')}>浏览全部论文书目 ↗</a></section>
</Layout>

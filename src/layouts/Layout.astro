---
import '../styles/global.css';
import '../styles/sports.css';
import {site,url} from '../lib/content.mjs';
const {title=site.tagline,description=site.description,article}=Astro.props;
const path=Astro.url.pathname;
const canonical=new URL(path,Astro.site || 'https://example.invalid');
const nav=[['','首页'],...site.categories.map(c=>[`categories/${c.slug}/`,c.name])];
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light dark"/><meta name="site-id" content={site.siteId}/><meta name="application-name" content={site.name}/><title>{`${title} · ${site.name}${site.demo?'（演示）':''}`}</title><meta name="description" content={description}/><meta name="robots" content={site.demo?'noindex, follow':'index, follow'}/><link rel="canonical" href={canonical}/><link rel="icon" href={url('favicon.svg')} type="image/svg+xml"/><meta property="og:locale" content="zh_CN"/><meta property="og:type" content={article?'article':'website'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={site.name}/>{article&&<meta property="article:published_time" content={article.publishedAt}/>}
<script is:inline>try{const t=localStorage.getItem('theme');document.documentElement.dataset.theme=t||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script>
{article&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Article',headline:article.title,datePublished:article.publishedAt,inLanguage:'zh-CN',description:article.summary}).replace(/</g,'\\u003c')}/>}
</head><body><a class="skip" href="#main">跳至正文</a><div class="demo-bar">演示站点 <span>·</span> 所有文章均为演示内容，非真实资讯</div><header class="shell"><div class="masthead"><a class="brand" href={url('')} aria-label={`${site.name}首页`}><span class="brand-mark" aria-hidden="true">体</span><span>{site.name}<small>{site.tagline}</small></span></a><div class="header-note">以体育为中心<small>政策 · 科技 · 科研 · 产业</small></div><div class="tools"><a href={url('search/')} class="icon-button" aria-label="搜索内容"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></svg></a><button id="theme" class="icon-button" aria-label="切换深色模式" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 15A9 9 0 0 1 9 4a9 9 0 1 0 11 11Z"/></svg></button></div></div><nav aria-label="主导航">{nav.map(([href,label])=><a href={url(href)} aria-current={path===url(href)?'page':undefined}>{label}</a>)}</nav><div class="utility-nav"><span>体育专业情报 · 演示版</span><div><a href={url('articles/')}>全部内容</a><a href={url('categories/')}>栏目总览</a><a href={url('archive/')}>时间归档</a><a href={url('about/')}>关于本站</a></div></div></header><main id="main" class="shell" tabindex="-1"><slot/></main><footer class="shell"><div class="footer-top"><div><a class="footer-brand" href={url('')}>{site.name}<span> / 演示</span></a><p>{site.tagline}</p></div><div><a href={url('about/')}>关于本站</a><a href={url('archive/')}>内容归档</a><a href={url('status/')}>运行状态</a></div></div><div class="footer-bottom"><span>演示内容仅供界面与功能展示 · 日期均为北京时间</span><span>专注体育，理解变化。</span></div></footer>
<script>const button=document.querySelector<HTMLButtonElement>('#theme');function sync(){button?.setAttribute('aria-label',document.documentElement.dataset.theme==='dark'?'切换浅色模式':'切换深色模式')}sync();button?.addEventListener('click',()=>{const value=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=value;try{localStorage.setItem('theme',value)}catch{}sync()});</script>
</body></html>


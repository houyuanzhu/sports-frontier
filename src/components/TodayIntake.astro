---
import {url,dateText} from '../lib/content.mjs';
import {calendarDay} from '../lib/publication.mjs';
const {editions,latestContentEdition}=Astro.props;
const snapshotDay=calendarDay(new Date());
const today=editions.find(edition=>edition.date===snapshotDay);
---
<section class="daily-hero" data-intake-day={snapshotDay}>
 <div><p class="eyebrow">北京时间 · 首次收录</p><h2>今日新收录</h2>
 <p data-intake-current>{dateText(snapshotDay)}首次收录 {today?.count||0} 条。历史原文仍按各自原文日期标示。</p>
 <p data-intake-later hidden>今日暂无已上线的新收录记录。</p></div>
 {latestContentEdition
  ?<a class="text-link" href={url(`daily/${latestContentEdition.date}/`)}>阅读最近一期 ↗</a>
  :<a class="text-link" href={url('daily/')}>查看每日归档 ↗</a>}
</section>
<script>
import {calendarDay} from '../lib/publication.mjs';
const intake=document.querySelector<HTMLElement>('[data-intake-day]');
function refresh(){
 if(!intake)return;
 const stale=calendarDay(new Date())!==intake.dataset.intakeDay;
 intake.querySelector<HTMLElement>('[data-intake-current]')!.hidden=stale;
 intake.querySelector<HTMLElement>('[data-intake-later]')!.hidden=!stale;
}
refresh();
window.addEventListener('pageshow',refresh);
document.addEventListener('visibilitychange',()=>{if(!document.hidden)refresh();});
</script>
